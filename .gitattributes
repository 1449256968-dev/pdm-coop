# Normalise text files, keep Unity binary assets untouched.
* text=auto

*.cs      text diff=csharp
*.ps1     text
*.md      text
*.json    text
*.yml     text
*.xml     text
*.gitignore text
*.gitattributes text

# Unity YAML assets are text, but rewriting line endings churns diffs.
*.unity   -text
*.prefab  -text
*.asset   -text
*.meta    -text
*.mat     -text
*.controller -text
*.anim    -text
*.overrideController -text

# Binaries
*.png     binary
*.jpg     binary
*.jpeg    binary
*.tga     binary
*.psd     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.bundle  binary
*.wav     binary
*.ogg     binary
*.mp3     binary
*.ttf     binary
*.otf     binary
*.fbx     binary
*.zip     binary
*.gz      binary
